{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AstraPluginManifestSchema",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "author": { "type": "string" },
    "engineVersion": { "type": "string" },
    "description": { "type": "string" },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["READ_REPORTS", "READ_STATE", "READ_RESULTS", "READ_GRAPH", "READ_REGISTRY"]
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "beforeScan",
          "afterScan",
          "beforeEngine",
          "afterEngine",
          "beforeReport",
          "afterReport",
          "beforeValidate",
          "afterValidate"
        ]
      }
    }
  },
  "required": ["id", "name", "version", "engineVersion", "permissions", "hooks"]
}
